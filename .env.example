# Copy to .env and fill in. .env is gitignored: the RTSP URL below carries the
# camera's admin password in its userinfo field and must never be committed.
#
# The Reolink sub-stream is the right one to publish - roughly 640x360 at a low
# bitrate, which is what a phone actually wants. h264Preview_01_main is
# 2560x1920 and will saturate a Wi-Fi link for no visible gain behind a HUD.
MTX_CAMERA_URL=rtsp://USER:PASSWORD@CAMERA-IP:554/h264Preview_01_sub

# The host(s) the browser will reach MediaMTX on, for WebRTC ICE. Getting this
# wrong is the single most common failure: signalling succeeds, the log looks
# healthy, and the video stays black. See "MTX_WEBRTC_HOST" in docs/operations.md.
#
#   127.0.0.1        - watching on this machine only
#   192.168.1.50     - a phone or laptop on the LAN (use the host's LAN IP)
#   100.x.y.z        - over Tailscale (from "tailscale ip -4")
#
# Comma-separate to allow several: 127.0.0.1,192.168.1.50,100.x.y.z
MTX_WEBRTC_HOST=127.0.0.1
