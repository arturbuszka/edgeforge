<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- DirectML needs its native DLLs beside the binary. Without a RID the build
         copies only the managed wrapper, ORT then loads whatever DirectML.dll the
         system has - on this machine a 2022 build - and session creation dies with
         an opaque AbiCustomRegistry / 0x80070057 error. SelfContained stays false:
         we want the native assets, not a bundled runtime. -->
    <RuntimeIdentifier Condition="'$(OS)' == 'Windows_NT'">win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Local overrides: gitignored, so camera credentials and machine-specific
         paths live here instead of in the tracked file. Optional at runtime, but
         it has to reach the output directory to be found at all - configuration is
         read from AppContext.BaseDirectory, not from the project folder. -->
    <None Update="appsettings.Local.json" CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('appsettings.Local.json')" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\EdgeForge.Core\EdgeForge.Core.csproj" />
    <ProjectReference Include="..\EdgeForge.Vision\EdgeForge.Vision.csproj" />
    <ProjectReference Include="..\EdgeForge.Runtime\EdgeForge.Runtime.csproj" />
    <ProjectReference Include="..\EdgeForge.Decision\EdgeForge.Decision.csproj" />
  </ItemGroup>
</Project>
